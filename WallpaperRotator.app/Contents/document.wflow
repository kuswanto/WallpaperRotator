					<array>
						<string>com.apple.applescript.object</string>
					</array>
				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run AppleScript.action</string>
				<key>ActionName</key>
				<string>Run AppleScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>on run {input, parameters}	set targetFolder to POSIX path of (path to pictures folder from user domain) &amp; "GitHubWallpapers/"	do shell script "mkdir -p " &amp; quoted form of targetFolder		set apiURL to "https://api.github.com/repos/jalexsan/wallpapers/git/trees/master?recursive=1"	set curlCmd to "curl -s -H \"User-Agent: MacAutomator\" " &amp; quoted form of apiURL		-- 1. Fetch raw response to check for GitHub errors	set rawResponse to do shell script curlCmd		if rawResponse contains "API rate limit exceeded" then		display dialog "GitHub API rate limit exceeded (60 requests/hr). You must wait an hour for it to reset." buttons {"OK"} default button "OK" with icon caution		return input	else if rawResponse contains "\"message\": \"Not Found\"" then		display dialog "Repository not found." buttons {"OK"} default button "OK"		return input	end if		-- 2. Parse the paths	set grepCmd to "echo " &amp; quoted form of rawResponse &amp; " | grep -o '\"path\":\"[^\"]*\"' | grep -iE '\\.(png|jpg|jpeg)\"$' | sed 's/\"path\":\"//g' | sed 's/\"//g'"	set pathListText to do shell script grepCmd		if pathListText is "" then		display dialog "Could not parse any image paths from the repository." buttons {"OK"} default button "OK"		return input	end if		set pathList to paragraphs of pathListText	set randomPath to some item of pathList		-- 3. Extract filename and encode URL	set AppleScript's text item delimiters to "/"	set filename to last text item of randomPath	set AppleScript's text item delimiters to ""		set safePath to do shell script "echo " &amp; quoted form of randomPath &amp; " | sed 's/ /%20/g'"	set wallpaperUrl to "https://raw.githubusercontent.com/jalexsan/wallpapers/master/" &amp; safePath	set localPath to targetFolder &amp; filename		-- 4. Download	do shell script "curl -s -L -o " &amp; quoted form of localPath &amp; " " &amp; quoted form of wallpaperUrl		-- 5. Verify and Apply	set fileSize to do shell script "stat -f%z " &amp; quoted form of localPath	if (fileSize as integer) &gt; 1000 then		try			tell application "System Events"				set picture of every desktop to localPath			end tell						do shell script "find " &amp; quoted form of targetFolder &amp; " -type f ! -name " &amp; quoted form of filename &amp; " -delete"					on error errMsg			display dialog "macOS blocked the wallpaper change. Go to System Settings &gt; Privacy &amp; Security &gt; Automation, and ensure Automator has permission to control System Events. Error: " &amp; errMsg buttons {"OK"}		end try	else		display dialog "The downloaded file was empty. URL attempted: " &amp; wallpaperUrl buttons {"OK"}	end if		return inputend run</string>
				</dict>
